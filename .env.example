# Backend NestJS REST API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# System-level Machine-to-Machine Secret Key (matches SYSTEM_API_KEY in NestJS backend)
NEXT_PUBLIC_SYSTEM_KEY=sky_crawler_super_secret_system_key_2026_x77a9

# Auth Mode: "api" (default, connects to real NestJS backend) or "mock" (offline fallback)
NEXT_PUBLIC_AUTH_MODE=api
